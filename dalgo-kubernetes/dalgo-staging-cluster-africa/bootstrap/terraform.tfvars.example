# Set any variable from variables.tf here to override its default (e.g. nat_az = "af-south-1b"). Unset ones keep their default.

aws_region     = "af-south-1"
aws_profile    = "dalgo-staging-admin"
aws_account_id = ""

# Everything else defaults to the Africa layout (variables.tf): VPC 10.20.0.0/16, data path in af-south-1a.
