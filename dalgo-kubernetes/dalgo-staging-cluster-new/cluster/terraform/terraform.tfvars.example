aws_region     = "ap-south-1"
aws_profile    = "dalgo-staging"
aws_account_id = ""

cluster_name    = "dalgo-staging-cluster"
cluster_version = "1.36"

vpc_id = ""

# control plane ENIs: both private subnets (different AZs)
cluster_subnet_ids = ["", ""]

# all subnets, for the ALB discovery tags (one per AZ)
public_subnet_ids  = ["", "", ""]
private_subnet_ids = ["", "", ""]

# worker nodes: one private subnet
node_subnet_ids = [""]

# e.g. SSO admin role: arn:aws:iam::<acct>:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_AdministratorAccess_xxxx
admin_principal_arns = [""]

# staging EC2's SG (dalgo-staging-ec2-sg): lets it reach the cluster (all ports)
api_whitelist_security_group_ids = ["sg-0b742509cfc6add81"]

# same SG: terraform adds "4200 from cluster SG" to it (Prefect workers -> Prefect server)
staging_ec2_sg_id = "sg-0b742509cfc6add81"

# RDS SG: terraform adds "5432 from cluster SG". Leave unset until RDS exists.
# rds_sg_id = "sg-…"

# must exist in the new account; leave null for no SSH
# ssh_key_name = "dalgo-eks-staging-ec2-key-pair"
