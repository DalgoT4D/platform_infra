aws_region     = "ap-south-1"
aws_profile    = "dalgo-staging-admin"
aws_account_id = ""

# postgres master password: same value as in the team vault (min 8 chars; no / " @ or spaces)
master_password = ""

# Everything else defaults to the current dalgo-staging-rds (variables.tf). Override only what differs, e.g.:
# instance_class = "db.t4g.small"
